# OmniGaze-Agent Environment Configuration
# Copy this file to .env and fill in your values.

# ── Meta LLM Endpoint ──────────────────────────────────────
# Supports any OpenAI-compatible API (Baseten, HuggingFace TGI, vLLM, local)
LLM_BASE_URL=https://model-xxxxxxxxxx.api.baseten.co/v1
LLM_MODEL_ID=meta-models/muse-spark-open-1026
LLM_API_KEY=

# ── SAM Vision Endpoint (optional – falls back to local simulation) ─
SAM_ENDPOINT=
SAM_API_KEY=

# ── Telemetry ──────────────────────────────────────────────
TELEMETRY_LOG_PATH=mock_telemetry/telemetry_log.json
SYNTHETIC_IMAGE_PATH=mock_telemetry/synthetic_defect.png
