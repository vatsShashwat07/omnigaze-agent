# OmniGaze-Agent Environment Configuration
# Copy this file to .env and fill in your values.

# ── Meta LLM Endpoint (Baseten Cloud) ──────────────────────
BASETEN_API_KEY=your_key_here
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1

# ── SAM Vision Endpoint (optional – falls back to local simulation) ─
SAM_ENDPOINT=
SAM_API_KEY=

# ── Telemetry ──────────────────────────────────────────────
TELEMETRY_LOG_PATH=mock_telemetry/telemetry_log.json
SYNTHETIC_IMAGE_PATH=mock_telemetry/synthetic_defect.png
